<?xml version="1.0" ?>
<!--
r2000ic_165f (FANUC R-2000iC/165F) MoveIt2 SRDF — written by hand (not generated by the Setup Assistant), the same layout as
bringup/m20_35_18d. The chain of fanuc_r2000_description's r2000ic_165f_urdf_macro.xacro
(base_link -> J1_link..J6_link -> flange) is defined as a single planning group.
-->
<robot name="r2000ic_165f">

  <!-- The whole 6-axis chain J1~J6 from base_link to flange as a single planning group -->
  <group name="arm">
    <chain base_link="base_link" tip_link="flange" />
  </group>

  <!-- Default pose (all zeros): upper arm up, forearm horizontal -->
  <group_state name="home" group="arm">
    <joint name="J1" value="0" />
    <joint name="J2" value="0" />
    <joint name="J3" value="0" />
    <joint name="J4" value="0" />
    <joint name="J5" value="0" />
    <joint name="J6" value="0" />
  </group_state>

  <!-- world is the fixed base -->
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link" />

  <!-- Adjacent links always touch at the joint, which causes self-collision false positives, so they are disabled -->
  <disable_collisions link1="base_link" link2="J1_link" reason="Adjacent" />
  <disable_collisions link1="base_link" link2="wbase" reason="Adjacent" />
  <disable_collisions link1="J1_link" link2="J2_link" reason="Adjacent" />
  <disable_collisions link1="J2_link" link2="J3_link" reason="Adjacent" />
  <disable_collisions link1="J3_link" link2="J4_link" reason="Adjacent" />
  <disable_collisions link1="J4_link" link2="J5_link" reason="Adjacent" />
  <disable_collisions link1="J5_link" link2="J6_link" reason="Adjacent" />
  <disable_collisions link1="J6_link" link2="flange" reason="Adjacent" />
  <disable_collisions link1="flange" link2="ee_link" reason="Adjacent" />
  <disable_collisions link1="flange" link2="fanuc_flange" reason="Adjacent" />

</robot>
