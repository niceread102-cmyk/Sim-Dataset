<?xml version="1.0" encoding="utf-8"?>
<!-- JEGG-2510N, original uploaded fingers preserved byte-for-byte, 2026-10-09.
     Original flange/mount, joint frames, axes, mimic and TCP retained.
     Stock body/jaw meshes are drawing-based approximations, not OEM CAD.
     Each jaw: 5 mm travel, rated effort 75 N. Gap-speed convention: 87 mm/s.
     Stock assembly: 0.37 kg; link inertias/custom-part masses are estimates.
     0.7 mm separate mounting spacers keep original finger positions unchanged.
     Isaac Sim runtime and long-finger mechanical strength not verified. -->
<robot name="jegg2510n_original_fingers">
  <material name="blue">
    <color rgba="0.04 0.34 0.55 1" />
  </material>
  <material name="dark">
    <color rgba="0.16 0.19 0.22 1" />
  </material>
  <material name="body_silver">
    <color rgba="0.67 0.7 0.74 1" />
  </material>
  <link name="flange" />
  <joint name="flange_mount_joint" type="fixed">
    <parent link="flange" />
    <child link="gripper_mount" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="gripper_mount">
    <visual>
      <origin xyz="0.004 0 0" rpy="0 1.570796327 0" />
      <geometry>
        <cylinder radius="0.04" length="0.008" />
      </geometry>
      <material name="mount_gray">
        <color rgba="0.28 0.30 0.33 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.004 0 0" rpy="0 1.570796327 0" />
      <geometry>
        <cylinder radius="0.04" length="0.008" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.004 0 0" rpy="0 0 0" />
      <mass value="0.1085734421" />
      <inertia ixx="0.0001158116716" ixy="0" ixz="0" iyy="5.848489415e-05" iyz="0" izz="5.848489415e-05" />
    </inertial>
  </link>
  <joint name="flange_to_gripper_motor" type="fixed">
    <parent link="gripper_mount" />
    <child link="gripper_motor" />
    <origin xyz="0.008 0 0" rpy="0 1.570796327 0" />
  </joint>
  <link name="gripper_motor">
    <visual name="gripper_motor_visual_0">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/motor_body_m.stl" scale="1 1 1" />
      </geometry>
      <material name="body_silver" />
    </visual>
    <visual name="gripper_motor_visual_1">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/motor_rear_cap_m.stl" scale="1 1 1" />
      </geometry>
      <material name="dark" />
    </visual>
    <visual name="gripper_motor_visual_2">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/motor_front_cap_m.stl" scale="1 1 1" />
      </geometry>
      <material name="blue" />
    </visual>
    <visual name="gripper_motor_visual_3">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/motor_connector_m.stl" scale="1 1 1" />
      </geometry>
      <material name="dark" />
    </visual>
    <collision name="gripper_motor_collision_0">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/motor_collision_m.stl" scale="1 1 1" />
      </geometry>
    </collision>
    <collision name="gripper_motor_collision_1">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/motor_connector_base_collision_m.stl" scale="1 1 1" />
      </geometry>
    </collision>
    <collision name="gripper_motor_collision_2">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/motor_connector_plug_collision_m.stl" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="1.25575379961e-18 0.000712787159757 0.0413968800302" rpy="0 0 0" />
      <mass value="0.33" />
      <inertia ixx="0.000260778803016" ixy="-8.56455331834e-22" ixz="1.78741950702e-21" iyy="0.000209412484541" iyz="2.68077141646e-06" izz="9.63853225895e-05" />
    </inertial>
  </link>
  <link name="gripper_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/left_slider_m.stl" scale="1 1 1" />
      </geometry>
      <material name="left_slider_m_material">
        <color rgba="0.25 0.31 0.38 1" />
      </material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/left_finger_straight_m.stl" scale="1 1 1" />
      </geometry>
      <material name="left_finger_plus300_m_material">
        <color rgba="0.72 0.75 0.80 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/left_slider_collision_m.stl" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="1.13877748952e-09 0.00794695097371 0.167928678788" rpy="0 0 0" />
      <mass value="0.0370099623405" />
      <inertia ixx="0.000473049761987" ixy="2.9200213497e-13" ixz="-1.12187024289e-11" iyy="0.000471959985006" iyz="1.832579443e-05" izz="1.55662514892e-06" />
    </inertial>
    <collision name="left_uploaded_finger_collision_0">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/left_finger_collision_0_m.stl" scale="1 1 1" />
      </geometry>
    </collision>
    <collision name="left_uploaded_finger_collision_1">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/left_finger_collision_1_m.stl" scale="1 1 1" />
      </geometry>
    </collision>
    <collision name="left_uploaded_finger_collision_2">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/left_finger_collision_2_m.stl" scale="1 1 1" />
      </geometry>
    </collision>
    <visual name="left_finger_mount_spacer_visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/left_finger_mount_spacer_m.stl" scale="1 1 1" />
      </geometry>
      <material name="left_finger_plus300_m_material">
        <color rgba="0.72 0.75 0.80 1" />
      </material>
    </visual>
    <collision name="left_finger_mount_spacer_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/left_finger_mount_spacer_m.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_motor" />
    <child link="gripper_left" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.005" effort="75" velocity="0.0435" />
    <dynamics damping="2" friction="0.05" />
  </joint>
  <link name="gripper_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/right_slider_m.stl" scale="1 1 1" />
      </geometry>
      <material name="right_slider_m_material">
        <color rgba="0.25 0.31 0.38 1" />
      </material>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/right_finger_straight_m.stl" scale="1 1 1" />
      </geometry>
      <material name="right_finger_plus300_m_material">
        <color rgba="0.72 0.75 0.80 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/right_slider_collision_m.stl" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="1.13878073284e-09 -0.0079469509737 0.167928678637" rpy="0 0 0" />
      <mass value="0.0370099623405" />
      <inertia ixx="0.000473049762805" ixy="-2.92003085138e-13" ixz="-1.12187257377e-11" iyy="0.000471959985826" iyz="-1.83257944588e-05" izz="1.55662515077e-06" />
    </inertial>
    <collision name="right_uploaded_finger_collision_0">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/right_finger_collision_0_m.stl" scale="1 1 1" />
      </geometry>
    </collision>
    <collision name="right_uploaded_finger_collision_1">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/right_finger_collision_1_m.stl" scale="1 1 1" />
      </geometry>
    </collision>
    <collision name="right_uploaded_finger_collision_2">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/right_finger_collision_2_m.stl" scale="1 1 1" />
      </geometry>
    </collision>
    <visual name="right_finger_mount_spacer_visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/right_finger_mount_spacer_m.stl" scale="1 1 1" />
      </geometry>
      <material name="right_finger_plus300_m_material">
        <color rgba="0.72 0.75 0.80 1" />
      </material>
    </visual>
    <collision name="right_finger_mount_spacer_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/gripper/right_finger_mount_spacer_m.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_motor" />
    <child link="gripper_right" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0.005" effort="75" velocity="0.0435" />
    <dynamics damping="2" friction="0.05" />
    <mimic joint="gripper_left_joint" multiplier="1" offset="0" />
  </joint>
  <link name="gripper_tcp" />
  <joint name="gripper_tcp_joint" type="fixed">
    <parent link="gripper_motor" />
    <child link="gripper_tcp" />
    <origin xyz="0 0 0.4613158493" rpy="0 0 0" />
  </joint>
</robot>
