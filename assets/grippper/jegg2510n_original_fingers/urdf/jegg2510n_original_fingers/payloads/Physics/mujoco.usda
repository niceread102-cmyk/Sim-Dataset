over "jegg2510n_original_fingers"
{
    over "Physics"
    {
        def MjcActuator "gripper_left_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -2, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 75
            uniform double mjc:forceRange:min = -75
            uniform double[] mjc:gainPrm = [2, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            prepend rel mjc:target = </jegg2510n_original_fingers/Physics/gripper_left_joint>
        }

