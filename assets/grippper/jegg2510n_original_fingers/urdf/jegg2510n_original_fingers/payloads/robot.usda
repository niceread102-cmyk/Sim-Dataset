#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "jegg2510n_original_fingers"
    doc = """Generated from Composed Stage of root layer /tmp/tmp_ujpes14/jegg2510n_original_fingers.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_jegg2510n_original_fingers_frueg78_/usdex_jegg2510n_original_fingers/jegg2510n_original_fingers.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_jegg2510n_original_fingers_frueg78_/temp_jegg2510n_original_fingers/jegg2510n_original_fingers.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "jegg2510n_original_fingers" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </jegg2510n_original_fingers/Physics/flange_mount_joint>,
        </jegg2510n_original_fingers/Physics/flange_to_gripper_motor>,
        </jegg2510n_original_fingers/Physics/gripper_left_joint>,
        </jegg2510n_original_fingers/Physics/gripper_right_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </jegg2510n_original_fingers/Geometry/flange/gripper_mount>,
        </jegg2510n_original_fingers/Geometry/flange/gripper_mount/gripper_motor>,
        </jegg2510n_original_fingers/Geometry/flange/gripper_mount/gripper_motor/gripper_left>,
        </jegg2510n_original_fingers/Geometry/flange/gripper_mount/gripper_motor/gripper_right>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "flange"
        {
            over "gripper_mount" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "gripper_motor" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "gripper_left" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }

                    over "gripper_right" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }

                    over "gripper_tcp" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "flange_mount_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "flange_to_gripper_motor" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_left_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_right_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

