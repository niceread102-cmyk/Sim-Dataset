<?xml version='1.0' encoding='utf-8'?>
<robot name="rev6i_r6g_vacuum_gripper">
  <material name="metal">
    <color rgba="0.67 0.70 0.73 1" />
  </material>
  <material name="anodized">
    <color rgba="0.40 0.44 0.48 1" />
  </material>
  <material name="connector">
    <color rgba="0.18 0.19 0.20 1" />
  </material>
  <material name="cup_rubber">
    <color rgba="0.14 0.14 0.15 1" />
  </material>
  <!-- The base origin is the center of the upper plate face (CAD Z = 20 mm). Local +Z points toward the workpiece. Mesh vertices are in metres. -->
  <link name="gripper_base_link">
    <visual name="cup_rubber">
      <geometry>
        <mesh filename="meshes/visual/cup_rubber.stl" />
      </geometry>
      <material name="cup_rubber" />
    </visual>
    <visual name="connector">
      <geometry>
        <mesh filename="meshes/visual/connector.stl" />
      </geometry>
      <material name="connector" />
    </visual>
    <visual name="anodized">
      <geometry>
        <mesh filename="meshes/visual/anodized.stl" />
      </geometry>
      <material name="anodized" />
    </visual>
    <visual name="metal">
      <geometry>
        <mesh filename="meshes/visual/metal.stl" />
      </geometry>
      <material name="metal" />
    </visual>
    <!-- Compound collision proxies keep the cup, adjacent tip, and main shaft separate. -->
    <collision name="mount_plate">
      <origin xyz="0 0 0.016" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.054" length="0.032" />
      </geometry>
    </collision>
    <collision name="mount_hardware">
      <geometry>
        <mesh filename="meshes/collision/mount_hardware.stl" />
      </geometry>
    </collision>
    <collision name="side_connector">
      <geometry>
        <mesh filename="meshes/collision/side_connector.stl" />
      </geometry>
    </collision>
    <collision name="main_beam">
      <origin xyz="0 0 0.17" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.024 0.282" />
      </geometry>
    </collision>
    <collision name="upper_bracket">
      <geometry>
        <mesh filename="meshes/collision/upper_bracket.stl" />
      </geometry>
    </collision>
    <collision name="valve_section_1">
      <geometry>
        <mesh filename="meshes/collision/valve_section_1.stl" />
      </geometry>
    </collision>
    <collision name="valve_section_2">
      <geometry>
        <mesh filename="meshes/collision/valve_section_2.stl" />
      </geometry>
    </collision>
    <collision name="valve_section_3">
      <geometry>
        <mesh filename="meshes/collision/valve_section_3.stl" />
      </geometry>
    </collision>
    <collision name="inline_section_1">
      <geometry>
        <mesh filename="meshes/collision/inline_section_1.stl" />
      </geometry>
    </collision>
    <collision name="inline_section_2">
      <geometry>
        <mesh filename="meshes/collision/inline_section_2.stl" />
      </geometry>
    </collision>
    <collision name="inline_section_3">
      <geometry>
        <mesh filename="meshes/collision/inline_section_3.stl" />
      </geometry>
    </collision>
    <collision name="upper_coupling">
      <origin xyz="0.004 0.03349256 0.145" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.011" length="0.012" />
      </geometry>
    </collision>
    <collision name="upper_rod">
      <origin xyz="0.004 0.03349256 0.234" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.01" length="0.02" />
      </geometry>
    </collision>
    <collision name="middle_rod">
      <origin xyz="0.004 0.03349256 0.264" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.008" length="0.04" />
      </geometry>
    </collision>
    <collision name="lower_rod">
      <origin xyz="0.004 0.03349256 0.332" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.01" length="0.096" />
      </geometry>
    </collision>
    <collision name="lower_collar">
      <origin xyz="0.004 0.03349256 0.316" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0125" length="0.0272" />
      </geometry>
    </collision>
    <collision name="end_bracket">
      <origin xyz="0 0.009 0.316" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.082 0.01" />
      </geometry>
    </collision>
    <collision name="tip_nut">
      <geometry>
        <mesh filename="meshes/collision/tip_nut.stl" />
      </geometry>
    </collision>
    <collision name="tip_shaft">
      <origin xyz="0.004 -0.0203926 0.356435" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.007" length="0.07087" />
      </geometry>
    </collision>
    <collision name="tip_neck">
      <origin xyz="0.004 -0.0203926 0.39587" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.006" length="0.008" />
      </geometry>
    </collision>
    <collision name="tip_end">
      <geometry>
        <mesh filename="meshes/collision/tip_end.stl" />
      </geometry>
    </collision>
    <collision name="cup_lip">
      <geometry>
        <mesh filename="meshes/collision/cup_lip.stl" />
      </geometry>
    </collision>
  </link>
  <!-- TCP at the uncompressed suction cup lip center. Vacuum attachment is controlled in the simulator. -->
  <link name="suction_tcp" />
  <joint name="gripper_to_suction_tcp" type="fixed">
    <parent link="gripper_base_link" />
    <child link="suction_tcp" />
    <origin xyz="0.004 0.03349256 0.39" rpy="0 0 0" />
  </joint>
</robot>