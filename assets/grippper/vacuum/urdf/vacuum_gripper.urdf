<?xml version='1.0' encoding='utf-8'?>
<robot name="vacuum_gripper">
  <material name="aluminum">
    <color rgba="0.72 0.76 0.79 1.0" />
  </material>
  <material name="steel">
    <color rgba="0.55 0.58 0.62 1.0" />
  </material>
  <material name="dark_metal">
    <color rgba="0.32 0.37 0.43 1.0" />
  </material>
  <material name="hose_black">
    <color rgba="0.095 0.105 0.12 1.0" />
  </material>
  <material name="suction_silicone">
    <color rgba="0.71 0.40 0.20 1.0" />
  </material>
  <material name="polymer">
    <color rgba="0.23 0.27 0.30 1.0" />
  </material>
  <link name="vacuum_gripper_base_link">
    <visual name="aluminum">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/aluminum.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="aluminum" />
    </visual>
    <visual name="steel">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/steel.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="steel" />
    </visual>
    <visual name="dark_metal">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/dark_metal.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="dark_metal" />
    </visual>
    <visual name="hose_black">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/hose_black.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="hose_black" />
    </visual>
    <visual name="suction_silicone">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/suction_silicone.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="suction_silicone" />
    </visual>
    <visual name="polymer">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/polymer.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="polymer" />
    </visual>
  </link>
</robot>