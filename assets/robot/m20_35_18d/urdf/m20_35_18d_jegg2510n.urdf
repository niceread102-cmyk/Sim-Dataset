    <parent link="J6_link"/>
    <child link="phoxi_scanner"/>
    <origin xyz="0.143 0 0.07" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>
  <!-- Colour camera of the scanner: the round lens glass (mesh x -113.1, y -32.6, z 35.0 mm), as an OpenCV optical frame (x right, y down, z forward = the tool
       direction, flange +x): image right = flange -y, image down = flange -z (with the tool pointing down the robot base is at the bottom of the image, as seen
       from behind the camera). Used by the wrist camera of robot_sim.py (wrist_camera: in the robot yaml). -->
  <link name="phoxi_camera"/>
  <joint name="J6_to_phoxi_camera" type="fixed">
    <parent link="J6_link"/>
    <child link="phoxi_camera"/>
    <origin xyz="0.178 0.1131 0.1026" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>
</robot>
