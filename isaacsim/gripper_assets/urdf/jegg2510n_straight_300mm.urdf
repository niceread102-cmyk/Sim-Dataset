<?xml version="1.0" encoding="utf-8"?>
<!-- JEGG-2510N straight-tip +300 mm simulation variant, 2026-10-02.
     Based on the supplied JEGG-2008N URDF and JRT 2026 public JEGG specifications.

     VERIFIED JRT PUBLIC SPECS USED HERE (JEGG-2510 external-driver type):
       - body envelope: 63.2 x 29.0 x 103.5 mm
       - total jaw stroke: 10 mm (= 5 mm per jaw in this symmetric URDF)
       - max gripping force: 75 N (= 37.5 N per jaw in this symmetric URDF)
       - max open/close speed: 87 mm/s (= 43.5 mm/s per jaw)
       - gripper weight: 0.37 kg (catalog value; custom +300 mm fingers add extra mass)

     GEOMETRY STRATEGY:
       - Existing JEGG-2008N motor/slider meshes are retained but scaled to the
         2510N public body envelope. X/Y body scale is about 1.20, Z about 1.053.
       - The custom straight finger is NOT scaled in Z so the added 300 mm tool
         length stays 300 mm. It is shifted +5.2 mm in Z for the longer 2510 body.
       - TCP is shifted by the same +5.2 mm: 0.4613158493 -> 0.4665158493 m.

     IMPORTANT MOUNTING NOTE:
       JRT's public 2026 catalog gives overall dimensions/specs but not the exact
       JEGG-2510N jaw mounting thread/locating-pin pitch. Therefore this file
       intentionally does NOT claim manufacturing-accurate M3/M4 hole locations.
       The finger attachment region is only envelope-scaled from the supplied model.
       For production-accurate fastening geometry, replace it using the official
       JEGG-2510N 2D drawing/STEP file.

     Mesh units: meters. Mass/inertia values for the scaled/custom geometry are
     simulation estimates. Physical strength/mounting and Isaac Sim runtime must
     still be verified on the target setup. -->
<!-- Sim-Dataset: copied from jegg2510n_straight_300mm.urdf (2026-10-02); only mesh paths changed. The meshes are the
     JEGG-2008 straight-tip ones (scaled by the scale attributes above).
     Root link `flange` = the robot link the gripper is attached to (scripts/robot_sim.py `gripper:`). -->
<robot name="jegg2510n_straight_plus300">
  <link name="flange" />
  <joint name="flange_mount_joint" type="fixed">
    <parent link="flange" />
    <child link="gripper_mount" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="gripper_mount">
    <visual>
      <origin xyz="0.004 0 0" rpy="0 1.570796327 0" />
      <geometry>
        <cylinder radius="0.04" length="0.008" />
      </geometry>
      <material name="mount_gray">
        <color rgba="0.28 0.30 0.33 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.004 0 0" rpy="0 1.570796327 0" />
      <geometry>
        <cylinder radius="0.04" length="0.008" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.004 0 0" rpy="0 0 0" />
      <mass value="0.1085734421" />
      <inertia ixx="0.0001158116716" ixy="0" ixz="0" iyy="5.848489415e-05" iyz="0" izz="5.848489415e-05" />
    </inertial>
  </link>
  <joint name="flange_to_gripper_motor" type="fixed">
    <parent link="gripper_mount" />
    <child link="gripper_motor" />
    <origin xyz="0.008 0 0" rpy="0 1.570796327 0" />
  </joint>
  <link name="gripper_motor">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/jegg2510n_straight_300mm/visual/motor_body_m.stl" scale="1.198347107 1.201520913 1.052899288" />
      </geometry>
      <material name="motor_body_m_material">
        <color rgba="0.60 0.65 0.70 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/jegg2510n_straight_300mm/collision/motor_collision_m.stl" scale="1.198347107 1.201520913 1.052899288" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.006608363873 0.042642421160" rpy="0 0 0" />
      <mass value="0.3422522052" />
      <inertia ixx="0.000345716055132" ixy="0" ixz="0" iyy="0.000259335532584" iyz="0" izz="0.000144686377056" />
    </inertial>
  </link>
  <link name="gripper_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/jegg2510n_straight_300mm/visual/left_slider_m.stl" scale="1.198347107 1.201520913 1.052899288" />
      </geometry>
      <material name="left_slider_m_material">
        <color rgba="0.25 0.31 0.38 1" />
      </material>
    </visual>
    <visual>
      <origin xyz="0 0 0.0052" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/jegg2510n_straight_300mm/visual/left_finger_straight_m.stl" scale="1.199934010 1.199934010 1.000000000" />
      </geometry>
      <material name="left_finger_plus300_m_material">
        <color rgba="0.72 0.75 0.80 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/jegg2510n_straight_300mm/collision/left_slider_collision_m.stl" scale="1.198347107 1.201520913 1.052899288" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.0052" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/jegg2510n_straight_300mm/collision/left_finger_collision_0_m.stl" scale="1.199934010 1.199934010 1.000000000" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.0052" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/jegg2510n_straight_300mm/collision/left_finger_collision_1_m.stl" scale="1.199934010 1.199934010 1.000000000" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.009659467988 0.274607585900" rpy="0 0 0" />
      <mass value="0.0783113132" />
      <inertia ixx="0.000963061671686" ixy="0" ixz="0" iyy="0.000962048697601" iyz="0" izz="3.41271944048e-06" />
    </inertial>
    <collision>
      <origin xyz="0 0 0.0052" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/jegg2510n_straight_300mm/collision/left_finger_collision_shaft_m.stl" scale="1.199934010 1.199934010 1.000000000" />
      </geometry>
    </collision>
  </link>
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_motor" />
    <child link="gripper_left" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.005" effort="37.5" velocity="0.0435" />
    <dynamics damping="2" friction="0.05" />
  </joint>
  <link name="gripper_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/jegg2510n_straight_300mm/visual/right_slider_m.stl" scale="1.198347107 1.201520913 1.052899288" />
      </geometry>
      <material name="right_slider_m_material">
        <color rgba="0.25 0.31 0.38 1" />
      </material>
    </visual>
    <visual>
      <origin xyz="0 0 0.0052" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/jegg2510n_straight_300mm/visual/right_finger_straight_m.stl" scale="1.199934010 1.199934010 1.000000000" />
      </geometry>
      <material name="right_finger_plus300_m_material">
        <color rgba="0.72 0.75 0.80 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/jegg2510n_straight_300mm/collision/right_slider_collision_m.stl" scale="1.198347107 1.201520913 1.052899288" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.0052" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/jegg2510n_straight_300mm/collision/right_finger_collision_0_m.stl" scale="1.199934010 1.199934010 1.000000000" />
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.0052" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/jegg2510n_straight_300mm/collision/right_finger_collision_1_m.stl" scale="1.199934010 1.199934010 1.000000000" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.009659467988 0.274607585900" rpy="0 0 0" />
      <mass value="0.0783113132" />
      <inertia ixx="0.000963061671686" ixy="0" ixz="0" iyy="0.000962048697601" iyz="0" izz="3.41271944048e-06" />
    </inertial>
    <collision>
      <origin xyz="0 0 0.0052" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/jegg2510n_straight_300mm/collision/right_finger_collision_shaft_m.stl" scale="1.199934010 1.199934010 1.000000000" />
      </geometry>
    </collision>
  </link>
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_motor" />
    <child link="gripper_right" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0.005" effort="37.5" velocity="0.0435" />
    <dynamics damping="2" friction="0.05" />
    <mimic joint="gripper_left_joint" multiplier="1" offset="0" />
  </joint>
  <link name="gripper_tcp" />
  <joint name="gripper_tcp_joint" type="fixed">
    <parent link="gripper_motor" />
    <child link="gripper_tcp" />
    <origin xyz="0 0 0.4665158493" rpy="0 0 0" />
  </joint>
</robot>
